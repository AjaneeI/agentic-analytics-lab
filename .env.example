# Copy to .env locally if you need to override the active benchmark defaults.
# Never commit the real .env file.

# Current Python benchmark / ClickHouse tool
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Optional model override used by benchmark scripts that read OLLAMA_MODEL.
OLLAMA_MODEL=qwen2.5:7b

# Provider API keys plus LibreChat/Langfuse port settings from the original
# workshop reproduction are intentionally omitted here because the current
# Python benchmark does not read them. Historical workshop context is preserved
# in experiments/experiment-log.md and the upstream references in README.md.
