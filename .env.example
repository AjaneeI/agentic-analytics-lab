# Copy to .env locally. Never commit the real .env file.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ClickHouse variables used by the read-only query tool and benchmark preflight
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Example local service configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
LIBRECHAT_PORT=3080
LANGFUSE_PORT=3000
